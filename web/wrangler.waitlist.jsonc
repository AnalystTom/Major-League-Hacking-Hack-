{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resurface",
  "main": "src/waitlist.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    { "name": "WAITLIST_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resurface-waitlist",
      "database_id": "89d777a6-eb11-4feb-9484-6f555a3ba96e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
