{
  "name": "resurface-x-journey-test",
  "main": "entry.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"../../../public","binding":"ASSETS","run_worker_first":["/api/*","/media/*"]},
  "vars": {
    "X_CLIENT_ID":"fixture-client", "X_CLIENT_SECRET":"fixture-secret-not-a-real-credential",
    "X_CALLBACK_URL":"http://127.0.0.1:28757/api/auth/x/callback", "X_READS_ENABLED":"true",
    "X_TEST_AUTHORIZE_URL":"http://127.0.0.1:28757/fixture/authorize",
    "PROCESSOR_URL":"https://fixture/api/ingest/process"
  },
  "services":[{"binding":"X_PROVIDER","service":"resurface-x-fixture"},{"binding":"PROCESSOR","service":"resurface-x-fixture"}],
  "d1_databases":[{"binding":"DB","database_name":"resurface-x-fixture","database_id":"11111111-1111-4111-8111-111111111111","migrations_dir":"../../../migrations"}],
  "dev":{"port":28757}
}
