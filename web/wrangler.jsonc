{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resurface",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "services": [{ "binding": "PROCESSOR", "service": "resurface-processor" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "resurface-media" }],
  "ratelimits": [
    { "name": "IMPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "WAITLIST_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resurface-waitlist",
      "database_id": "89d777a6-eb11-4feb-9484-6f555a3ba96e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SHORTS": "on",
    "DAILY_VIDEO_LIMIT": "20",
    "MONTHLY_VIDEO_LIMIT": "400",
    "USER_DAILY_IMPORT_LIMIT": "5",
    "SIGNUP_DAILY_LIMIT": "200",
    "SIGNUP_IP_DAILY_LIMIT": "5",
    "SIGNUPS": "on",
    "X_CLIENT_ID": "VnhpUllybnRqVFBmeXZoR0xnbks6MTpjaQ",
    "X_CALLBACK_URL": "https://resurface.thomasmann2001.workers.dev/api/auth/x/callback",
    "X_DAILY_READ_REQUEST_LIMIT": "60",
    "X_USER_DAILY_READ_REQUEST_LIMIT": "55",
    "X_READS_ENABLED": "true"
  },
  "observability": { "enabled": true }
}
