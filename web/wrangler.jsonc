{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resurface",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // postgres.js needs Node's Buffer and crypto, plus cloudflare:sockets for the TCP connection.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // The processor Worker, called through a binding: a plain fetch() to another workers.dev Worker fails (error 1042).
  "services": [{ "binding": "PROCESSOR", "service": "resurface-processor" }],
  // Rendered shorts (mp4), captions (vtt) and posters. Create once: npx wrangler r2 bucket create resurface-media
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "resurface-media" }],
  // Imports: 5 per account per minute. Sign-up and sign-in: 10 per IP per minute.
  "ratelimits": [
    { "name": "IMPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // TigerData: set DATABASE_URL with `npx wrangler secret put DATABASE_URL` (or in .dev.vars locally).
  // Optional: PROCESSOR_URL and PROCESSOR_TOKEN for the service that turns units into shorts.
  // The landing page collects emails through /api/waitlist in the existing D1 database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resurface-waitlist",
      "database_id": "89d777a6-eb11-4feb-9484-6f555a3ba96e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
