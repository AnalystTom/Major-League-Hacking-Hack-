# Copy to server/.env (gitignored) for `npm run dev`. Never commit real values.

# Ingestion is mounted only when GEMINI_API_KEY is set. The web Worker's PROCESSOR_TOKEN must equal INGEST_TOKEN,
# and its PROCESSOR_URL is http://<this host>:3000/api/ingest/process.
GEMINI_API_KEY=
INGEST_TOKEN=
# Digests, skills/tasks and short scripts. Without it, units are extracted only.
NICRRON_API_KEY=
# X post links are read from twitterapi.io; without it X units fail with "TWITTERAPI_IO_KEY is not configured".
# TWITTERAPI_IO_KEY=
# NICRRON_MODEL=nicrron/auto
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore

# The processor Worker proxies its D1 binding. Its INGEST_TOKEN is the D1_TOKEN below. Enables the sweeps.
D1_URL=
D1_TOKEN=

# Media for rendered shorts: the R2 bucket's S3 API ...
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=resurface-media
# ... or, for local dev, the web/ folder whose `wrangler dev` serves /media/ from its local R2.
# MEDIA_LOCAL_WEB_DIR=../web
# MEDIA_LOCAL_PERSIST_TO=   (only when wrangler dev runs with --persist-to)

# New units per UTC day and month across all users (0 pauses processing). Defaults 10 and 40.
# DAILY_VIDEO_LIMIT=10
# MONTHLY_VIDEO_LIMIT=40
# Mount the dev POST /api/ingest/imports route (reads links directly, outside the limits). Local use only.
# ENABLE_DEV_IMPORTS=1
# PORT=3000
# SWEEP_INTERVAL_MS=60000
# Shorts are drawn with motion-graphic-skill in headless Chromium (CHROME, else a local Chrome is found);
# basic switches to plain ffmpeg text cards (RENDER_FONT below).
# RENDER_STYLE=basic
# RENDER_FONT=/path/to/Bold.ttf
