OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=high
# Total creative request deadline; also applied to HTTP headers/body waits.
OPENAI_TIMEOUT_MS=900000
# Editorial: source-specific shots + content audit + parallel speech + browser capture.
# Set fast for the legacy three-beat renderer.
# Set creative only for the slower original geometry/Remotion path.
MOTION_GENERATION_MODE=editorial
MOTION_FAST_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
MOTION_ARTIFACTS=./artifacts
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Shared ingestion/frontend database (app requires db/migrations/001 through 009).
DATABASE_URL=
# Alternative local Tiger service settings. Database credentials are separate from API keys.
# Verify and save DATABASE_URL with: motion database --configure-tiger
TIGER_DATA_SERVICE_URL=
TIGER_DATA_USERNAME=
TIGER_DATA_PASSWORD=
TIGER_DATA_DATABASE_NAME=
GEMINI_API_KEY=
# Generated by node scripts/setup-local.mjs at the repository root.
INGEST_TOKEN=
PROCESSOR_TOKEN=
PROCESSOR_URL=http://127.0.0.1:3000/api/ingest/process
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Alternatively use these dashboard-style aliases. R2_* takes precedence.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
# Management/deployment token, separate from the S3 credentials above.
CLOUDFLARE_API_TOKEN=
# Reserved app credentials; X ingestion is not implemented yet.
TWITTER_API_KEY=
TWITTER_API_SECRET=
# Reserved for supporting-source research; not used by the current pipeline.
# The configuration check accepts NIMBLE_API_KEY or NIMBLE_API_SECRET.
NIMBLE_API_SECRET=
R2_BUCKET=resurface-media
MOTION_MEDIA_STORAGE=local
# Optional: built-in procedural music is used when no custom track is set.
MOTION_MUSIC_FILE=
MOTION_MUSIC_PROVENANCE=
